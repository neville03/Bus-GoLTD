# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The public address of the site, used in sign-up confirmation emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: email alerts to the Bus&Go team (https://resend.com). Leave blank to turn off.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Bus&Go <alerts@yourdomain.com>
